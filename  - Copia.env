ARIBA_BUYER_ANIDS=AN01393304604

ARIBA_TOKEN_URL=https://api.ariba.com/v2/oauth/token
ARIBA_API_BASE=https://openapi.ariba.com/api/purchase-orders-supplier/v1/prod

# Importacao historica inicial
ARIBA_BOOTSTRAP_DAYS=365

# Em cada execucao normal, revisita alguns dias para capturar
# pedidos novos, alteracoes e eventuais execucoes perdidas.
ARIBA_INCREMENTAL_LOOKBACK_DAYS=7

# ============================================================
# SAP BUSINESS ONE - SERVICE LAYER
# ============================================================
SAP_SL_URL=https://sap-brasmo-sl.skyinone.net:50000
SAP_COMPANY_DB=BRASMO_PRD
SAP_USER=Rafael.Scheffer
SAP_PASSWORD=San@#3628

# POC atual usa false porque a TI testou com curl -k.
# Em producao, o ideal e corrigir o certificado e mudar para true.
SAP_VERIFY_SSL=false

# ============================================================
# MONITOR
# ============================================================
# Se um pedido continuar sem NumAtCard no SAP, ele pode ser lembrado
# novamente na proxima execucao. Como o programa roda apenas duas vezes
# ao dia, 4 horas evita repeticoes acidentais.
PENDING_REMINDER_HOURS=4

# Se um pedido ja lancado no SAP ganhar nova versao no Ariba,
# gera alerta para revisao.
NOTIFY_ARIBA_CHANGES=true

# Quantos pedidos recentes aparecem no painel HTML.
REPORT_RECENT_LIMIT=100

# FATURADO e EXPEDIDO sao considerados encerrados.
FINAL_SAP_POSITIONS=FATURADO,EXPEDIDO,CANCELADO

# ============================================================
# AGENDAMENTO
# ============================================================
# O instalador de tarefas usa 13:30 por padrao para a execucao da tarde.
